{
  "name": "skillswap-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Võ Quang Tâm's personal engineering blog powered by NestJS.",
  "scripts": {
    "build": "node scripts/sync-site-url.mjs && nest build",
    "lint": "tsc --noEmit",
